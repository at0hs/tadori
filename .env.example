# 開発用の値（ダミー）。.env に写して使う。.env はコミットしない。
# 本番用の変数（BETTER_AUTH_SECRET、INITIAL_ADMIN_* など）は、使う段階で足す。

# 利用者がブラウザで開く URL（D-52）。開発では Vite の開発サーバー。
APP_URL=http://localhost:5173

# API の待ち受けポート
PORT=3000

# 開発用の DB（compose.dev.yaml の db-dev）
DATABASE_URL=postgres://tadori:tadori-dev@localhost:5433/tadori
