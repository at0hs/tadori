# .env に写して使う。.env はコミットしない（D-20）。値はすべてダミー。
# 変数の意味は docs/operations.md の 2.1 を参照。
#
# 本番（docker compose up）では、少なくとも「本番で必ず書き換える」の値を作り直す。
# 開発（pnpm dev）では、このままで動く。

# ---- 本番で必ず書き換える ----

# 利用者がブラウザで開く URL（D-52）。Better Auth の基準 URL と CSRF の確認に使う。
# 本番では http://<サーバーの名前>:3000。HTTPS（compose.https.yaml）なら https://<サーバーの名前>（末尾の / ・パス・ポートは付けない）。
# 開発では Vite の開発サーバー（/api は API に転送される）。
APP_URL=http://localhost:5173

# Better Auth の秘密鍵（32文字以上）。例：openssl rand -base64 32
# この値のままでは本番の app は起動しない。変えると全員のセッションが切れる。
BETTER_AUTH_SECRET=dev-secret-dev-secret-dev-secret-0123456789

# DB のパスワード（本番の compose だけで使う）。URL に埋めるので英数字だけにする。例：openssl rand -hex 24
# 効くのは DB のボリュームを初めて作るときだけ。後から変えても DB のパスワードは変わらない。
POSTGRES_PASSWORD=change-me-0123456789abcdef

# 初期管理者（D-20）。ユーザーが1人もいないときだけ使う。初回ログインでパスワードの変更を求められる。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=管理者
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=Initial-passw0rd-dummy

# ---- 必要なら変える ----

# 前段のリバースプロキシのアドレス（カンマ区切り）。置かないなら空のまま（D-52、D-60）。
# HTTPS（compose.https.yaml）では使わない（CADDY_IP が自動で入る）。
TRUSTED_PROXIES=

# 本番で app を公開するホストのポート
# HTTPS（compose.https.yaml）では、127.0.0.1 だけで待ち受ける（サーバーの外から直接 app に届かない）。
APP_PORT=3000

# バックアップを取る時刻（日本時間、HH:MM）。カンマ区切りで複数書ける（例：03:00,15:00）。
BACKUP_TIMES=03:00

# 自動のバックアップを残す数。日数ではなくファイルの数（1日2回なら 7 は3.5日分）。
BACKUP_KEEP=7

# ---- HTTPS（compose.https.yaml の Caddy）で使う（operations.md 9章） ----

# 次の2行のコメントを外すと、docker compose のコマンドが compose.https.yaml も読み、Caddy が起動する。
# 区切りを : にそろえる行は、Windows でも同じ書き方で動かすため。
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=compose.yaml:compose.https.yaml

# 証明書の用意の仕方。次のどれか。
#   internal                              … Caddy が自分の認証局で出す（ルート証明書を端末に信頼させる）
#   /certs/tadori.crt /certs/tadori.key   … ./certs に置いた証明書（中間証明書もつなげる）と秘密鍵を使う
#   you@example.test                      … Let's Encrypt から取る（インターネットに公開する場合）
CADDY_TLS=

# Caddy と app だけがつながるネットワークの範囲、自動で割り当てる範囲、Caddy の IP。
# 社内 LAN や同じホストの別の環境とぶつかるときだけ、3つをそろえて変える（CADDY_IP は PROXY_IP_RANGE の外に）。
PROXY_SUBNET=10.203.53.0/24
PROXY_IP_RANGE=10.203.53.128/25
CADDY_IP=10.203.53.2

# ---- 開発だけで使う（本番の compose は自分で決めるので読まない） ----

# API の待ち受けポート
PORT=3000

# 開発用の DB（compose.dev.yaml の db-dev）
DATABASE_URL=postgres://tadori:tadori-dev@localhost:5433/tadori
