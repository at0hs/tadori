#!/usr/bin/env bash
# 復元（operations.md 6.1）。DB を作り直してからダンプを戻す。ダンプの後の変更はすべて失われる。
#   docker compose stop app
#   docker compose exec backup tadori-restore <ダンプ> [--yes]
#   docker compose start app
set -euo pipefail
# shellcheck source=../lib.sh
source /opt/tadori/lib.sh

given="" yes=false
for arg in "$@"; do
  case "$arg" in
    --yes) yes=true ;;
    *) given="$arg" ;;
  esac
done
if [[ -z "$given" ]]; then
  err "戻すダンプを指定してください（例：tadori-restore manual/tadori-20261108-101500.dump）"
  exit 1
fi
dump=$(resolve_dump "$given")

# app などがつないでいる間は戻さない（書き込みと混ざる）
others=$(psql -X -At -d postgres -c \
  "SELECT count(*) FROM pg_stat_activity WHERE datname = '$PGDATABASE' AND pid <> pg_backend_pid()")
if ((others > 0)); then
  err "DB に $others 件の接続があります。app を止めてから実行してください（docker compose stop app）"
  exit 1
fi

if ! $yes; then
  if [[ ! -t 0 ]]; then
    err "確認の入力ができません。--yes を付けて実行してください"
    exit 1
  fi
  echo "DB「$PGDATABASE」を消して、$dump の内容に戻します。ダンプの後の変更はすべて失われます。"
  read -r -p "続けるなら yes と入力してください：" answer
  if [[ "$answer" != "yes" ]]; then
    log "やめた"
    exit 1
  fi
fi

log "復元を始める：$dump"
psql -X -q -d postgres -v ON_ERROR_STOP=1 \
  -c "DROP DATABASE \"$PGDATABASE\"" \
  -c "CREATE DATABASE \"$PGDATABASE\" OWNER \"$PGUSER\""
if ! pg_restore --exit-on-error --no-owner -d "$PGDATABASE" <"$dump"; then
  err "復元に失敗した。DB は途中の状態なので、もう一度実行してください"
  exit 1
fi
log "復元した。app を起動してください（docker compose start app）"
